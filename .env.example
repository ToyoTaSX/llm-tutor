# Скопируйте этот файл в .env и при необходимости поменяйте значения.
# Все значения ниже рабочие для RTX 5060 Ti 16 ГБ.

# ---------- Пользователи и сессии ----------
# Логины лекторов через запятую (без паролей). Регистр и пробелы не важны.
# Лектор регистрируется через обычную форму. Зарегистрируйте эти логины сразу после первого запуска.
LECTURER_LOGINS=lecturer
# Секрет для подписи сессий. ОБЯЗАТЕЛЕН. Любая длинная случайная строка, например:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Срок жизни сессии, часов
JWT_TTL_HOURS=24

# ---------- Модели ----------
# Папка с моделями на хосте (см. models/README.md)
MODELS_DIR=./models
# Файл языковой модели внутри MODELS_DIR
LLM_FILE=Qwen2.5-3B-Instruct-Q4_K_M.gguf
# Папка модели эмбеддингов внутри MODELS_DIR
EMB_MODEL_DIR=bge-m3
# cuda или cpu
EMB_DEVICE=cuda
# Размер батча эмбеддера при индексации
EMB_BATCH=16

# ---------- llama-server ----------
# Общий контекст сервера, делится между слотами: 32768 / 4 = 8192 токена на запрос
LLM_CTX=32768
# Число параллельных запросов (слотов)
LLM_PARALLEL=4

# ---------- RAG ----------
# Сколько фрагментов отдаём модели
TOP_K=6
# Сколько кандидатов берём из каждого вида поиска (dense и sparse) до слияния
CANDIDATES=20
# Константа слияния рангов (Reciprocal Rank Fusion)
RRF_K=60
# Размер фрагмента и перекрытие соседних фрагментов, символов
CHUNK_CHARS=1000
OVERLAP_CHARS=200
# Параметры генерации
TEMPERATURE=0.2
MAX_TOKENS=1024

# ---------- Веб-поиск через MCP (режим «Курс + интернет») ----------
# API-ключ Tavily. Значение задаётся только здесь, в .env (файл не попадает в git).
# Без ключа сервер Tavily MCP отвечает ошибкой, и веб-режим отвечает по лекциям с сообщением
# «Интернет-поиск временно недоступен». Ключ передаётся заголовком Authorization и маскируется в логах.
TAVILY_API_KEY=
# Адрес MCP-сервера (транспорт Streamable HTTP)
MCP_URL=https://mcp.tavily.com/mcp/
# Тайм-аут всего веб-поиска, секунд
MCP_TIMEOUT_S=10
# Сколько результатов поиска передаётся модели и сколько символов выдержки на результат
MCP_MAX_RESULTS=3
MCP_SNIPPET_CHARS=800
# Имя поискового инструмента; пусто — выбрать по списку инструментов сервера (*search*)
MCP_SEARCH_TOOL=
# 1 — добавлять к результатам синтетический результат со строкой-инъекцией (только для проверки)
MCP_INJECT_TEST=0

# ---------- Порты на хосте ----------
UI_PORT=3000
LLM_PORT=8080
QDRANT_PORT=6333
